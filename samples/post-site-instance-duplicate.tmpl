#!/bin/sh
#
# Cloud Hook: post-site-instance-duplicate
#
# The post-site-instance-duplicate hook is run after a site instance has been
# duplicated to create a new environment. This allows you to perform
# post-duplication configuration, data scrubbing, or environment-specific setup.
# See ../README.md for details.
#
# Usage: post-site-instance-duplicate app-name stage source-site-name [extra-args...]
#
# Arguments:
#   $1: app-name (application name)
#   $2: stage (environment/stage name)
#   $3: source-site-name (the name of the source site that was duplicated)
#   $4+: extra-args (optional parameters passed from the API, e.g., flags or config)

app_name="$1"
stage="$2"
source_site_name="$3"
# Extra args start at position 4
extra_arg1="${4:-}"

echo "$app_name.$stage: Site instance duplicated from $source_site_name."

# Example: Use extra args to control behavior
if [ -n "$extra_arg1" ]; then
  echo "Extra argument received: $extra_arg1"
  # Add your custom logic here based on extra args
  # Example: if [ "$extra_arg1" = "scrub-emails" ]; then
  #   drush @$app_name.$stage sql-query "UPDATE users SET mail = CONCAT('user', uid, '@example.com')"
  # fi
fi
