#!/bin/sh
#
# Cloud Hook: post-site-associate
#
# The post-site-associate hook is run after a site has been associated with
# an environment. This allows you to perform initialization tasks, configure
# environment-specific settings, or set up integrations.
#
# The hook runs for every route that produces a site instance: a new
# association, a restore of a recently disassociated site instance, a
# reassociation without data, and the restore of a soft-deleted site. Write it
# to be idempotent: check whether an external resource exists before creating
# it, or upsert instead of create.
#
# Usage: post-site-associate app-name stage site-name association-type
#
# association-type is one of: new, restore, reassociate

app_name="$1"
stage="$2"
site_name="$3"
association_type="$4"

echo "$app_name.$stage: Site $site_name associated with environment ($association_type)."
