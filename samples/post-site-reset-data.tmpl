#!/bin/sh
#
# Cloud Hook: post-site-reset-data
#
# The post-site-reset-data hook is run after a site's database and files have
# been reset from an environment. This allows you to perform cleanup,
# notifications, or initialization of a fresh environment.
#
# Usage: post-site-reset-data app-name stage

app_name="$1"
stage="$2"

echo "$app_name.$stage: Site data reset completed."
