#!/bin/sh
#
# Cloud Hook: post-site-disassociate
#
# The post-site-disassociate hook is run when a user disassociates a site from
# an environment, right after the site instance is marked for deletion and
# stops serving. It does NOT run when the grace period ends and the data is
# permanently deleted. Until then the database and files are retained and the
# user can restore the site instance, which runs post-site-associate again.
#
# A failure in this hook does not reverse the disassociation and the hook is
# not retried. Do work that must succeed in pre-site-disassociate instead.
#
# Usage: post-site-disassociate app-name stage site-name grace-period-seconds

app_name="$1"
stage="$2"
site_name="$3"
grace_period_seconds="$4"

echo "$app_name.$stage: Site $site_name disassociated (data retained for ${grace_period_seconds}s)."
