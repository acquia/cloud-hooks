#!/bin/sh
#
# Cloud Hook: pre-site-reset-data
#
# The pre-site-reset-data hook is run before a site's database and files are
# reset from an environment. This allows you to perform backups or other
# preparatory actions before the site data is removed.
#
# Usage: pre-site-reset-data app-name stage site-name

app_name="$1"
stage="$2"
site_name="$3"

echo "$app_name.$stage: Preparing for site data reset for site $site_name."
